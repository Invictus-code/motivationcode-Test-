<?xml version="1.0" encoding="utf-8"?>
<!-- Sichert nur Favoriten und Einstellungen (DataStore), keine geplanten Erinnerungen. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
