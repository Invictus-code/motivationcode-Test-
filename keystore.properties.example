# Vorlage für die Release-Signatur.
# Als keystore.properties im selben Ordner speichern (wird von git ignoriert) und Werte eintragen.
# storeFile: Pfad zur .jks-Datei, absolut oder relativ zum Projektordner. Die .jks gehört nicht ins Repo.
# Achtung: In dieser Datei ist \ ein Steuerzeichen. Unter Windows deshalb / schreiben
# (z. B. C:/Users/name/keys/tagesmotivation-release.jks) und ein \ im Passwort als \\ eintragen.
storeFile=/pfad/zu/tagesmotivation-release.jks
storePassword=
keyAlias=tagesmotivation
keyPassword=
